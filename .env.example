# Runtime
BARBAROSSA_RUNTIME_DIR=.runtime
BARBAROSSA_IMAGE_TAG=latest
BARBAROSSA_TIMEZONE=America/Sao_Paulo
BARBAROSSA_HERMES_ENV_FILE=./hermes.env

# Dashboard exposure
HERMES_DASHBOARD_BIND=127.0.0.1
HERMES_DASHBOARD_PORT=9119

# Service resources
BARBAROSSA_HERMES_MEMORY=1024m
BARBAROSSA_HERMES_CPUS=1.00
BARBAROSSA_HERMES_PIDS=256
BARBAROSSA_FORGE_MEMORY=1408m
BARBAROSSA_FORGE_CPUS=1.50
BARBAROSSA_FORGE_PIDS=384
BARBAROSSA_RECON_MEMORY=640m
BARBAROSSA_RECON_CPUS=1.00
BARBAROSSA_RECON_PIDS=256

# Codex capability
BARBAROSSA_CODEX_MODEL=gpt-5.6-luna
BARBAROSSA_CODEX_REASONING_EFFORT=medium
BARBAROSSA_CODEX_MAX_SUBAGENTS=1

# External credentials
# Empty values use files beneath BARBAROSSA_RUNTIME_DIR.
BARBAROSSA_CODEX_AUTH_FILE=
BARBAROSSA_GITHUB_TOKEN_FILE=
