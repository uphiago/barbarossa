# === LLM Provider (at least ONE) ===
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# === Hermes model selection ===
HERMES_PROVIDER=deepseek
HERMES_MODEL=deepseek/deepseek-v4-flash

# === Dashboard (required) ===
DASHBOARD_USER=
DASHBOARD_PASS=
DASHBOARD_SECRET=

# === SSH (local development; setup.sh generates the key when absent) ===
BARBAROSSA_SSH_KEY=
BARBAROSSA_AUTHORIZED_KEYS_FILE=./worker/ssh-keys/authorized_keys
