# Hermes
DEEPSEEK_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
DASHBOARD_USER=
DASHBOARD_PASS=
DASHBOARD_SECRET=

# Immutable worker release tag or digest-compatible tag
BARBAROSSA_IMAGE_TAG=latest

# External runtime files. Keep all real values outside Git.
BARBAROSSA_WORKER_SSH_KEY_FILE=.runtime/worker_key
BARBAROSSA_AUTHORIZED_KEYS_FILE=.runtime/authorized_keys
BARBAROSSA_KNOWN_HOSTS_FILE=.runtime/known_hosts
BARBAROSSA_CODEX_TOKEN_FILE=.runtime/codex_access_token
BARBAROSSA_ROUTER_BUNDLE=.runtime/barbarossa-router.pex

# Optional setup input. Prefer an already-created token file.
CODEX_ACCESS_TOKEN=
